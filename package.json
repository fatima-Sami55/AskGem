{
  "name": "askperi",
  "version": "1.0.0",
  "private": true,
  "description": "AskPeri — single-user local education advisor",
  "scripts": {
    "setup": "node scripts/setup.js",
    "setup:ai": "node scripts/setup-ai.js",
    "dev": "node scripts/dev.js",
    "kill:dev": "node -e \"require('./scripts/lib/kill-dev-ports').killDevPorts()\"",
    "dev:win": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "dev:unix": "bash scripts/start-local.sh",
    "health": "node scripts/health.js",
    "verify": "node scripts/verify-stack.js",
    "smoke": "node scripts/smoke-test.js",
    "build": "cd client && npm run build",
    "start:prod": "node scripts/start-prod.js",
    "start:prod:check": "node scripts/start-prod.js",
    "install-all": "npm run setup && npm run setup:ai"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
